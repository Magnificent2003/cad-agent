# ===== DeepSeek =====
## DeepSeek API Key
DEEPSEEK_API_KEY=
## Default URL
DEEPSEEK_BASE_URL=https://api.deepseek.com
## Default Model: deepseek-flash
DEEPSEEK_MODEL=deepseek-flash
CAD_API_BASE_URL=http://127.0.0.1:8000
CAD_INTERNAL_TOKEN=
AGENT_BASE_URL=http://127.0.0.1:4096
AGENT_SERVER_USERNAME=opencode
AGENT_SERVER_PASSWORD=
CAD_DATA_DIR=./data
ODA_EXECUTABLE=./cad_converter/run.sh
CAD_FONT_DIRS=
CAD_CONVERSION_TIMEOUT=120
CAD_JOB_TIMEOUT=300
CAD_MAX_UPLOAD_MB=100
CAD_PREVIEW_DPI=120
ODA_USE_XVFB=false
CAD_FALLBACK_FONT=NotoSansCJKsc-Regular.otf
CAD_EXPORT_TOLERANCE=0.0000001

# ===== codex =====
wss_proxy=http://127.0.0.1:7078
https_proxy=http://127.0.0.1:7078
http_proxy=http://127.0.0.1:7078
all_proxy=http://127.0.0.1:7078
WSS_PROXY=http://127.0.0.1:7078
HTTPS_PROXY=http://127.0.0.1:7078
HTTP_PROXY=http://127.0.0.1:7078
ALL_PROXY=http://127.0.0.1:7078
AGENT_RUNTIME=release

# 模型网络路径：auto 优先直连，失败才使用代理；direct / proxy 可显式指定。
DEEPSEEK_NETWORK_MODE=auto

# Preferred internal RPC port; dev.sh may select a free alternative for this run.
FREECAD_RPC_PORT=9875
