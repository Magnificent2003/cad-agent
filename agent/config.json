{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-cad/deepseek-flash",
  "small_model": "deepseek-cad/deepseek-flash",
  "default_agent": "cad",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "enabled_providers": [
    "deepseek-cad"
  ],
  "agent": {
    "cad": {
      "description": "CAD 图纸助手",
      "mode": "primary",
      "prompt": "{file:./prompts/cad.txt}"
    }
  },
  "provider": {
    "deepseek-cad": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek CAD",
      "options": {
        "baseURL": "{env:DEEPSEEK_BASE_URL}",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash",
          "attachment": true,
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "freecad": {
      "type": "local",
      "command": [
        "bash",
        "freecad/mcp.sh"
      ],
      "enabled": true,
      "timeout": 300000
    }
  },
  "permission": {
    "*": "deny",
    "freecad_*": "allow"
  }
}
